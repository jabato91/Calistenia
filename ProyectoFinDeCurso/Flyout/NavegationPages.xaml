<?xml version="1.0" encoding="utf-8" ?>
<FlyoutPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoFinDeCurso.Flyout.NavegationPages"
             Title="NavegationPages">
    <FlyoutPage.Flyout>
        <ContentPage Title="Menú" BackgroundColor="LightGray">
            <StackLayout Padding="20">
                <Label Text="Menú de navegación"
                       FontAttributes="Bold"
                       FontSize="20"
                       Margin="0,0,0,20"/>
                
            </StackLayout>
        </ContentPage>
    </FlyoutPage.Flyout>

    <!-- Detail: Página principal -->
    <FlyoutPage.Detail>
        <NavigationPage>
            <x:Arguments>
                <ContentPage Title="Inicio">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="Bienvenido a la página principal" 
                               FontSize="24" />
                    </StackLayout>
                </ContentPage>
            </x:Arguments>
        </NavigationPage>
    </FlyoutPage.Detail>
</FlyoutPage>