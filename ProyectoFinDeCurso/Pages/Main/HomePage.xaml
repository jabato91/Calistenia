<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoFinDeCurso.Pages.HomePage"
             Title="HomePage">
    <NavigationPage.TitleView>
        <!--Es la parte de arriba de la página-->
        <Grid Padding="10"
      ColumnDefinitions="Auto,*,Auto"
      VerticalOptions="Center">
            <!--Grid permite ordenar los Campos internos, definiendo las columnas como Auto: Se ajusta al contenido, y *: Ocupa el espacio restante-->

            <!-- Título centrado donde Grid.Column lo define como la primera fila -->
            <Label Grid.Column="1"
           Text="Inicio"
           HorizontalOptions="Center"
           VerticalOptions="Center"
           FontSize="22"
           FontAttributes="Bold"
           TextColor="#C77B30"
           FontFamily="Forresten"/>

            <!-- Botón derecha donde Grid.Column lo define como la segunda fila -->
            <ImageButton Grid.Column="2"
                 Source="icono_predeterminado.png"
                 WidthRequest="35"
                 HeightRequest="35"
                 BackgroundColor="Transparent"
                     Clicked="profile"/>
        </Grid>
    </NavigationPage.TitleView>
    <ContentPage.Background> <!--Define el fondo de la página-->
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1A1A1A" Offset="0.0"/>
            <GradientStop Color="#2E1E1B" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>
    <VerticalStackLayout><!--almacena los componentes en vertical-->
        <Label 
            Text="Bienvenido a mi aplicación de calistenia.&#10;Esta app está diseñada para ayudarte a mejorar tu entrenamiento de una forma práctica y personalizada. Aquí podrás explorar ejercicios y rutinas ya creadas, pero también tendrás la posibilidad de diseñar tus propias rutinas según tus objetivos y nivel de experiencia. La idea es darte libertad total para crear y ajustar tus entrenamientos, eligiendo los ejercicios, repeticiones y descansos que más te convengan. Con esta aplicación podrás organizar mejor tu progreso y entrenar a tu manera, sin depender de rutinas fijas."
            VerticalOptions="Center" 
            HorizontalOptions="Center" 
            HorizontalTextAlignment="Center"
            LineHeight="2.3"
            Margin="20,50,20,0"
            FontSize="15"/>
            <!--Texto de presentación-->
    </VerticalStackLayout>
</ContentPage>