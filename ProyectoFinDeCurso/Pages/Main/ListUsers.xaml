<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoFinDeCurso.Pages.Main.ListUsers"
             Title="ListUsers">
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1A1A1A" Offset="0.0"/>
            <GradientStop Color="#2E1E1B" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>
    <VerticalStackLayout Padding="10">
        
        <CollectionView ItemsSource="{Binding Users}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="1"
           Margin="20"
           BorderColor="LightGray"
           CornerRadius="10"
           BackgroundColor="#3B2523">

                        <!-- Usamos un Grid para alinear texto e íconos -->
                        <Grid ColumnDefinitions="*,Auto"
              VerticalOptions="Center"
              Margin="20,0,20,0">

                            <!-- Columna izquierda: contenido -->
                            <VerticalStackLayout Grid.Column="0"
                                 Spacing="3"
                                 VerticalOptions="Center">
                                <Label Text="{Binding Id}" />
                                <Label Text="{Binding FullName}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="Orange"
                                       FontFamily="EatMeAlive"/>
                                <Label Text="{Binding Email, StringFormat='Correo: {0}'}" 
                       FontSize="14"
                       TextColor="Gray" />
                                <Label Text="{Binding Phone, StringFormat='Teléfono: {0}'}"
                       FontSize="14"
                       TextColor="Gray" />
                                <Label Text="{Binding listUserType, StringFormat='Tipo de Usuario: {0}'}" 
                       FontSize="14"
                       TextColor="Gray" />
                            </VerticalStackLayout>

                            <!-- Columna derecha: íconos centrados verticalmente -->
                            <HorizontalStackLayout Grid.Column="1"
                                 VerticalOptions="Center"
                                 Spacing="10"
                                 HorizontalOptions="End">

                                <ImageButton Source="editar.png"
                             WidthRequest="24"
                             HeightRequest="24"
                             BackgroundColor="Transparent"
                             Clicked="modifyUser" />

                                <ImageButton Source="papelera.png"
                             WidthRequest="24"
                             HeightRequest="24"
                             BackgroundColor="Transparent"
                             Clicked="EliminateUser" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>