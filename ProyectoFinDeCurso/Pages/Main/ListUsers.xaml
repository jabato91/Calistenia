<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoFinDeCurso.Pages.Main.ListUsers"
             Title="ListUsers">
    <ContentPage.Background><!--Fondo de la página-->
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1A1A1A" Offset="0.0"/>
            <GradientStop Color="#2E1E1B" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>
    <VerticalStackLayout Padding="10"
        HorizontalOptions="Fill">
        <SearchBar Placeholder="Buscar ejercicio por correo electrónico"
       Text="{Binding SearchText}"
       BackgroundColor="#2B2B2B"
       TextColor="#E0CFC2"
       PlaceholderColor="#A59D95"/> <!--Barra de busqueda el usuario por correo, obteniendo el usuario a tiempo real-->
        <CollectionView ItemsSource="{Binding FilteredExercisesByMail}"><!--Filtra los usuarios dependiendo del usuario buscado desde el metodo FilteredExercisesByMail-->
            <CollectionView.ItemTemplate>
                <DataTemplate><!---Crea los usuarios de la lista-->
                    <Border
                    Padding="1"
                    Margin="20"
                    Stroke="LightGray"
                    StrokeThickness="1"
                    BackgroundColor="#3B2523">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <!--Fondo de cada usuario-->
                        <!-- Usamos un Grid para alinear texto e íconos -->
                        <Grid ColumnDefinitions="*,Auto"
                          VerticalOptions="Center"
                          Margin="20,0,20,0">

                            <!-- Columna izquierda: contenido -->
                            <VerticalStackLayout Grid.Column="0"
                                 Spacing="3"
                                 VerticalOptions="Center">
                                <Label Text="{Binding Id}" />
                                <!--Id del usuario-->
                                <Label Text="{Binding FullName}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="Orange"
                                       FontFamily="EatMeAlive"/>
                                <!--Nombre completo del usuario-->
                                <Label Text="{Binding Email, StringFormat='Correo: {0}'}" 
                       FontSize="14"
                       TextColor="Gray" />
                                <!--Correo del usuario-->
                                <Label Text="{Binding Phone, StringFormat='Teléfono: {0}'}"
                       FontSize="14"
                       TextColor="Gray" />
                                <!--Telefono del usuario-->
                                <Label Text="{Binding listUserType, StringFormat='Tipo de Usuario: {0}'}" 
                       FontSize="14"
                       TextColor="Gray" />
                            </VerticalStackLayout>

                            <!-- Columna derecha: íconos centrados verticalmente -->
                            <HorizontalStackLayout Grid.Column="1"
                                 VerticalOptions="Center"
                                 Spacing="10"
                                 HorizontalOptions="End">

                                <ImageButton Source="editar.png"
                             WidthRequest="24"
                             HeightRequest="24"
                             BackgroundColor="Transparent"
                             Clicked="modifyUser" />
                                <!--Boton en el que hazcedes al metodo modifyUser para modificar el usuario-->

                                <ImageButton Source="papelera.png"
                             WidthRequest="24"
                             HeightRequest="24"
                             BackgroundColor="Transparent"
                             Clicked="EliminateUser" />
                                <!--Boton en el que hazcedes al metodo EliminateUser para eliminar el usuario-->
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>