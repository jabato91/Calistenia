<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ProyectoFinDeCurso.Pages.Main.RoutinesPage"
             Title="RoutinesPage">
    <VerticalStackLayout Padding="20">
        <CollectionView ItemsSource="{Binding Routines}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <toolkit:Expander>
                        <toolkit:Expander.Header>
                            <Border Stroke="#171616"
                            StrokeThickness="4"
                            Background="Black"
                            Padding="16,8"
                            HorizontalOptions="Fill">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="40,40,0,0" />
                                </Border.StrokeShape>
                                <Label Text="{Binding nameRoutine}"
                               FontAttributes="Bold"
                               FontSize="18"
                               TextColor="Black"/>
                            </Border>
                        </toolkit:Expander.Header>

                        <toolkit:Expander.Content>
                            <CollectionView ItemsSource="{Binding Exercises}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Label Text="{Binding name}" />
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </toolkit:Expander.Content>
                    </toolkit:Expander>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>