<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoFinDeCurso.Pages.Main.exercisePage"
             Title="Ejercicios"
             Background="#C78585">

    <ScrollView x:Name="Scroll">
        <VerticalStackLayout Padding="10" Spacing="10" HorizontalOptions="Center" VerticalOptions="Center" x:Name="StackContainer">

            <SearchBar Placeholder="Buscar ejercicio"
                       Text="{Binding SearchText}" />
            <CollectionView ItemsSource="{Binding FilteredExercises}"
                IsGrouped="True"
                ItemsUpdatingScrollMode="KeepScrollOffset"
                            x:Name="ExercisesList">

                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="#824646"
                               BorderColor="#824646"
                               CornerRadius="8"
                               Padding="6"
                               Margin="2,2,2,2"
                               HasShadow="False">
                            <StackLayout BackgroundColor="#8A4A4A" Padding="8">
                                <Label Text="{Binding MuscleGroupId}" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0.5,1,3,1">
                            <!-- margen entre items -->
                            <Frame BorderColor="#C44B4B"
                            BackgroundColor="Transparent"
                            CornerRadius="10"
                            Margin="0.5,5,1,5"
                            HasShadow="True"
                            VerticalOptions="Center">        

                                <Grid>
                                    <!-- Imagen de fondo -->
                                    <Image Source="{Binding image}" 
                                           Aspect="AspectFill" 
                                           WidthRequest="220"
                                           HeightRequest="300"/>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <!-- Texto arriba -->
                                            <RowDefinition Height="*"/>
                                            <!-- Espacio intermedio -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- Botones abajo -->
                                        </Grid.RowDefinitions>

                                        <!-- Texto arriba -->
                                        <Label Text="{Binding name}" 
                                           FontSize="20" 
                                           FontAttributes="Bold" 
                                           TextColor="#FFFFFF" 
                                           FontFamily="AnandaPersonal" 
                                           HorizontalTextAlignment="Center"
                                           VerticalOptions="Start"
                                           Margin="10"/>    

                                        <!-- Botones abajo a la derecha -->
                                        <StackLayout Grid.Row="2" 
                                            Orientation="Horizontal" 
                                            HorizontalOptions="End" 
                                            VerticalOptions="End"
                                            Spacing="10"
                                            Margin="0,0,10,10">

                                            <ImageButton Clicked="eliminateExercise"
                                             Source="papelera.png"
                                             WidthRequest="40"
                                             HeightRequest="40"
                                             BackgroundColor="Transparent"
                                             Aspect="AspectFill"/>

                                            <ImageButton Clicked="modifyExercise" 
                                            Source="editar.png"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            BackgroundColor="Transparent"
                                            />   
                                        </StackLayout>

                                    </Grid>
                                </Grid>

                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnExerciseTapped" CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>

                            </Frame>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>