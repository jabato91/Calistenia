<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoFinDeCurso.Pages.Main.exercisePage"
             Title="Ejercicios">
    <!-- 👇 Zona personalizada del título -->
    <NavigationPage.TitleView>
        <Grid Padding="10"
          ColumnDefinitions="Auto,*,Auto"
          VerticalOptions="Center">

            <!-- Título centrado -->
            <Label Grid.Column="1"
               Text="Ejercicios"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               FontSize="22"
               FontAttributes="Bold"
               TextColor="#C77B30"
               FontFamily="Forresten"/>

            <!-- Botón derecha -->
            <ImageButton Grid.Column="2"
                     Source="icono_predeterminado.png"
                     WidthRequest="35"
                     HeightRequest="35"
                     BackgroundColor="Transparent"/>
        </Grid>
    </NavigationPage.TitleView>
    <!-- Fondo con degradado sutil -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1A1A1A" Offset="0.0"/>
            <GradientStop Color="#2E1E1B" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="10"
                             Spacing="10"
                             HorizontalOptions="Fill"
                             VerticalOptions="Fill">

            <!-- Barra de búsqueda -->
            <HorizontalStackLayout
             HorizontalOptions="Fill">
                <SearchBar Placeholder="Buscar ejercicio por nombre"
                Text="{Binding SearchText}"
                BackgroundColor="#2B2B2B"
                TextColor="#E0CFC2"
                PlaceholderColor="#A59D95"/>
                <Button Text="Filtrar"
                Clicked="filterExercises"/>
            </HorizontalStackLayout>
            <!-- CollectionView de ejercicios -->
            <CollectionView ItemsSource="{Binding FilteredExercises}"
                IsGrouped="True"
                ItemsUpdatingScrollMode="KeepScrollOffset"
                HorizontalOptions="Fill">

                <!-- Encabezado de grupo -->
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate>
                        <Border Stroke="#66605E"
                            StrokeThickness="1"
                            BackgroundColor="#232020"
                            Padding="2"
                            Margin="5"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill">    

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#3B2928" Offset="0.0"/>
                                    <GradientStop Color="#3B2523" Offset="0.5"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <StackLayout Padding="8">
                                <Label Text="{Binding DisplayName}" 
                                       FontAttributes="Bold" 
                                       HorizontalTextAlignment="Center"
                                       TextColor="#C77B30"
                                       FontFamily="Forresten"
                                       FontSize="30"/>
                            </StackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <!-- Layout de items -->
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" />
                </CollectionView.ItemsLayout>

                <!-- Plantilla de item -->
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0.5,5,2,5">
                            <Border
                                Stroke="#66605E"
                                StrokeThickness="1"
                                BackgroundColor="#232020"
                                VerticalOptions="Center"
                                Padding="0.4">  

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>


                                <Grid>

                                    <!-- Aura verde pulsante -->
                                    <BoxView Background="{Binding AuraColor}" />

                                    <!-- Imagen de fondo -->
                                    <Image Source="{Binding image}" 
                                           Aspect="AspectFill"
                                           WidthRequest="200"
                                           HeightRequest="300"
                                           />

                                    <!-- Contenido de la carta -->
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Nombre -->
                                        <Label Text="{Binding name}" 
                                               FontSize="25" 
                                               FontAttributes="Bold" 
                                               TextColor="#C49362" 
                                               FontFamily="EatMeAlive"
                                               HorizontalTextAlignment="Center"
                                               VerticalOptions="Start"
                                               Margin="10"/>

                                        <!-- Botones -->
                                        <StackLayout Grid.Row="2"
                                                     Orientation="Horizontal"
                                                     HorizontalOptions="End"
                                                     VerticalOptions="End"
                                                     Spacing="10"
                                                     Margin="0,0,10,10">

                                            <ImageButton Clicked="eliminateExercise"
                                                         Source="papelera.png"
                                                         WidthRequest="40"
                                                         HeightRequest="40"
                                                         BackgroundColor="Transparent"
                                                         Aspect="AspectFill"
                                                         x:Name="eliminateButton"
                                                         IsVisible="{Binding IsAdminMode}"/>

                                            <ImageButton Clicked="modifyExercise" 
                                                         Source="editar.png"
                                                         WidthRequest="75"
                                                         HeightRequest="75"
                                                         BackgroundColor="Transparent"
                                                         x:Name="modifyButton"
                                                         IsVisible="{Binding IsAdminMode}"/>
                                        </StackLayout>

                                    </Grid>
                                </Grid>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnExerciseTapped" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
            <Border
                Stroke="#808080"
                StrokeThickness="4"
                Background="#3B2523"
                Padding="16,8"
                Margin="30,10"
                HorizontalOptions="Fill"
                AutomationProperties.Name="Crear rutina"
                AutomationProperties.HelpText="Botón para crear una rutina">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                    Tapped="createExercise"
                    CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>

                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                    <Label 
                        Text="Crear Ejercicio"
                        TextColor="#CFC86D"
                        FontAttributes="Bold"
                        FontSize="20"
                        FontFamily="Forresten"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center" />   
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>