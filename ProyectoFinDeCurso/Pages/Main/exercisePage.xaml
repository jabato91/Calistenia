<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoFinDeCurso.Pages.Main.exercisePage"
             Title="Ejercicios">

    <!-- Fondo con degradado sutil -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1A1A1A" Offset="0.0"/>
            <GradientStop Color="#2E1E1B" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">

            <!-- Barra de búsqueda -->
            <SearchBar Placeholder="Buscar ejercicio"
                       Text="{Binding SearchText}"
                       BackgroundColor="#2B2B2B"
                       TextColor="#E0CFC2"
                       PlaceholderColor="#A59D95"/>

            <!-- CollectionView de ejercicios -->
            <CollectionView ItemsSource="{Binding FilteredExercises}"
                            IsGrouped="True"
                            ItemsUpdatingScrollMode="KeepScrollOffset">

                <!-- Encabezado de grupo -->
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate>
                        <Frame BorderColor="#1F1C1C" 
                               CornerRadius="8"
                               Padding="6"
                               Margin="2"
                               HasShadow="False"
                               BackgroundColor="Transparent">
                            <Frame.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#3B2928" Offset="0.0"/>
                                    <GradientStop Color="#3B2523" Offset="0.5"/>
                                </LinearGradientBrush>
                            </Frame.Background>

                            <StackLayout Padding="8">
                                <Label Text="{Binding DisplayName}" 
                                       FontAttributes="Bold" 
                                       HorizontalTextAlignment="Center"
                                       TextColor="#C77B30"
                                       FontFamily="Forresten"
                                       FontSize="30"/>
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <!-- Layout de items -->
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" />
                </CollectionView.ItemsLayout>

                <!-- Plantilla de item -->
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0.5,5,2,5">
                            <Frame BorderColor="#66605E"
                                   BackgroundColor="#232020"
                                   CornerRadius="12"
                                   HasShadow="True"
                                   VerticalOptions="Center"
                                   Padding="0.4">

                                <Grid>

                                    <!-- Aura verde pulsante -->
                                    <BoxView Background="{Binding AuraColor}" />

                                    <!-- Imagen de fondo -->
                                    <Image Source="{Binding image}" 
                                           Aspect="AspectFill"
                                           WidthRequest="200"
                                           HeightRequest="300"
                                           />

                                    <!-- Contenido de la carta -->
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Nombre -->
                                        <Label Text="{Binding name}" 
                                               FontSize="25" 
                                               FontAttributes="Bold" 
                                               TextColor="#C49362" 
                                               FontFamily="EatMeAlive"
                                               HorizontalTextAlignment="Center"
                                               VerticalOptions="Start"
                                               Margin="10"/>

                                        <!-- Botones -->
                                        <StackLayout Grid.Row="2"
                                                     Orientation="Horizontal"
                                                     HorizontalOptions="End"
                                                     VerticalOptions="End"
                                                     Spacing="10"
                                                     Margin="0,0,10,10">

                                            <ImageButton Clicked="eliminateExercise"
                                                         Source="papelera.png"
                                                         WidthRequest="40"
                                                         HeightRequest="40"
                                                         BackgroundColor="Transparent"
                                                         Aspect="AspectFill"
                                                         x:Name="eliminateButton"/>

                                            <ImageButton Clicked="modifyExercise" 
                                                         Source="editar.png"
                                                         WidthRequest="75"
                                                         HeightRequest="75"
                                                         BackgroundColor="Transparent"
                                                         x:Name="modifyButton"/>
                                        </StackLayout>

                                    </Grid>
                                </Grid>

                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnExerciseTapped" CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>

                            </Frame>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>