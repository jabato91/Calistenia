<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoFinDeCurso.Pages.Main.exercisePage"
             Title="Ejercicios"
             Background="#C78585">

    <ScrollView x:Name="Scroll">
        <VerticalStackLayout Padding="10" Spacing="10" HorizontalOptions="Center" VerticalOptions="Center" x:Name="StackContainer">

            <SearchBar Placeholder="Buscar ejercicio"
                       Text="{Binding SearchText}" />
            <CollectionView ItemsSource="{Binding FilteredExercises}"
                IsGrouped="True"
                ItemsUpdatingScrollMode="KeepScrollOffset"
                            x:Name="ExercisesList">

                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="#824646"
                               BorderColor="#824646"
                               CornerRadius="8"
                               Padding="6"
                               Margin="2,2,2,2"
                               HasShadow="False">
                            <StackLayout BackgroundColor="#8A4A4A" Padding="8">
                                <Label Text="{Binding MuscleGroupId}" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0.5,1,3,1">
                            <!-- margen entre items -->
                            <Frame BorderColor="#C44B4B"
                               BackgroundColor="#C44B4B"
                               CornerRadius="10"
                               Margin="0.5,5,1,5"
                               Padding="10"
                               HasShadow="True"
                                   
                                   VerticalOptions="Center">
                                <!--Lista de objetos-->
                                <StackLayout>
                                    <Label Text="{Binding execiseID}" FontSize="20" FontAttributes="Bold" TextColor="#787878" IsVisible="False"/>
                                    <Label Text="{Binding name}" FontSize="20" FontAttributes="Bold" TextColor="#262626" FontFamily="AnandaPersonal" HorizontalTextAlignment="Center"/>
                                    <Image Source="{Binding image}" 
                                       HeightRequest="260"
                                           WidthRequest="200"
                                       Aspect="AspectFill"
                                       HorizontalOptions="Center" 
                                       Margin="0,10,0,10" />
                                    <Button Clicked="eliminateExercise" x:Name="eliminateE" Text="Eliminar" BackgroundColor="#A82A2A" Margin="15,1,15,1"/>
                                    <Button Clicked="modifyExercise" x:Name="modifyE" Text="Actualizar" BackgroundColor="#A82A2A" Margin="15,1,15,1"/>
                                </StackLayout>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnExerciseTapped" CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>
                            </Frame>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>