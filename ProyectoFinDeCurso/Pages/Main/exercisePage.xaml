<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoFinDeCurso.Pages.Main.exercisePage"
             Title="Ejercicios">

    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="10">

            <SearchBar Placeholder="Buscar ejercicio"
                       Text="{Binding SearchText}" />
            <CollectionView ItemsSource="{Binding FilteredExercises}"
                IsGrouped="True"
                ItemsUpdatingScrollMode="KeepScrollOffset"
                SelectionMode="Single"
                SelectionChanged="OpenExercise">

                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate>
                        <StackLayout BackgroundColor="#eeeeee" Padding="8">
                            <Label Text="{Binding MuscleGroupId}" FontAttributes="Bold" />
                        </StackLayout>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="LightGray" CornerRadius="10" Margin="10" Padding="10">
                            <StackLayout>
                                <Label Text="{Binding name}" FontSize="20" FontAttributes="Bold"/>
                                <Label Text="{Binding description}" FontSize="16"/>
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>