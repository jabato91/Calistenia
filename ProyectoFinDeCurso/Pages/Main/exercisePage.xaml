<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoFinDeCurso.Pages.Main.exercisePage"
             Title="Ejercicios">
    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="10">
            <!-- SearchBar fuera del CollectionView -->
            <SearchBar Placeholder="Buscar ejercicio"
                       Text="{Binding SearchText}" />
        <CollectionView ItemsSource="{Binding FilteredExercises}"
                        ItemsUpdatingScrollMode="KeepScrollOffset">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="LightGray" CornerRadius="10" Margin="10" Padding="10">
                        <StackLayout>
                            <Label Text="{Binding name}" FontSize="20" FontAttributes="Bold" Margin="0,10,0,0"/>
                            <Label Text="{Binding description}" FontSize="16" Margin="0,5,0,0"/>
                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>